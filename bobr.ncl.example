# A bobr build profile. Copy it next to where you want to build:
#
#     cp <recipes>/bobr.ncl.example ./bobr.ncl
#     mkdir bobr-store
#     <recipes>/bin/bobr-build.sh
#
# It describes one installation -- where the store is, what to build, which
# overlays to apply -- and nothing about a single run: the run's name and its log
# and work directories are minted per invocation by the driver.
#
# Every field is optional; the values below are the defaults. Relative paths are
# resolved against this file, so it means the same thing wherever you invoke the
# driver from.
{
  # What to build when the command line does not say (`--target NAME`).
  target = "test_all",

  # The store. Create it yourself -- the driver will not, so that a mistyped
  # path fails at once instead of starting a from-scratch rebuild somewhere
  # unexpected.
  store = "bobr-store",

  # Where per-run directories are made. Default to <store>/logs and <store>/work.
  # The work directory has to be on the store's filesystem.
  # logs = "bobr-store/logs",
  # work = "bobr-store/work",

  # Files layered over the recipe set, in order. Each evaluates to one overlay
  # or to an array of them.
  # overlays = ["./my-overlay.ncl"],

  # Builders to run at once; 0 lets bobr use the available parallelism.
  # jobs = 0,

  # Keep only warnings and errors on screen.
  # quiet = false,

  # Run bobr under `podman unshare`, for hosts without unprivileged user
  # namespaces.
  # podman_unshare = false,

  # Acquisition limits used by bobr during the normal build.
  # Downloads per host default to 6 (what servers expect of one client), and
  # the overall cap is derived from the file-descriptor limit. 0 means "let
  # the fetcher decide".
  #
  # The one host that needs less than the default is gitlab.freedesktop.org,
  # and not because it is fragile: its `/-/archive/<commit>/` URLs are not
  # files but a tarball built from the repository per request. Six of those at
  # once is more than it will do -- a from-scratch fetch of test_all drew HTTP
  # 502 from nearly every one of its 14 sources, 26 retries between them,
  # spread over the whole first minute rather than one bad moment. Nothing
  # failed, since the retries covered it, but it is waste on both sides.
  fetch = {
    per_host = { "gitlab.freedesktop.org" = 2 },
    # per_host_default = 6,
    # max_connections = 64,
    # max_local_jobs = 4,
  },

  # Optional local secondary capabilities. A store may be listed in either or
  # both arrays; content sources must share a filesystem with the working store.
  # secondaries = {
  #   trusted_indexes = [{ name = "previous", store = "../old-store" }],
  #   content_sources = [{ name = "previous", store = "../old-store" }],
  # },
}
