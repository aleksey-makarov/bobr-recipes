From: bobr
Subject: [PATCH] locale: make the locale archive relocatable

HostBundle processes run without a chroot, so the compile-time
COMPLOCALEDIR path resolves on the host.  Honor LOCALE_ARCHIVE as an
authoritative archive path.  Unlike the Nix patch this is deliberately
strict: when the variable is set, failure to open that path must not fall
back to a host archive.

Use secure_getenv so secure execution retains the normal FHS behavior.
Teach both locale and localedef about the same path, including archive
creation and enlargement.

--- a/locale/loadarchive.c
+++ b/locale/loadarchive.c
@@ -124,6 +124,18 @@
 }
 
 
+static int
+open_locale_archive (void)
+{
+  const char *path = secure_getenv ("LOCALE_ARCHIVE");
+
+  if (path == NULL)
+    path = archfname;
+
+  return __open_nocancel (path, O_RDONLY | O_LARGEFILE | O_CLOEXEC);
+}
+
+
 /* Find the locale *NAMEP in the locale archive, and return the
    internalized data structure for its CATEGORY data.  If this locale has
    already been loaded from the archive, just returns the existing data
@@ -202,7 +214,7 @@
       archmapped = &headmap;
 
       /* The archive has never been opened.  */
-      fd = __open_nocancel (archfname, O_RDONLY|O_LARGEFILE|O_CLOEXEC);
+      fd = open_locale_archive ();
       if (fd < 0)
 	/* Cannot open the archive, for whatever reason.  */
 	return NULL;
@@ -397,8 +409,7 @@
 	  if (fd == -1)
 	    {
 	      struct __stat64_t64 st;
-	      fd = __open_nocancel (archfname,
-				    O_RDONLY|O_LARGEFILE|O_CLOEXEC);
+	      fd = open_locale_archive ();
 	      if (fd == -1)
 		/* Cannot open the archive, for whatever reason.  */
 		return NULL;
--- a/locale/programs/locale.c
+++ b/locale/programs/locale.c
@@ -632,6 +632,18 @@
 }
 
 
+static const char *
+locale_archive_name (void)
+{
+  const char *path = secure_getenv ("LOCALE_ARCHIVE");
+
+  if (path == NULL)
+    path = ARCHIVE_NAME;
+
+  return path;
+}
+
+
