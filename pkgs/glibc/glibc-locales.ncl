# glibc locale archive, generated by localedef from the matching final glibc.
#
# The selection is intentionally kept as overridable node fields:
#
#   glibc_locales = prev.glibc_locales & {
#     locales = ["en_US.UTF-8", "ru_RU.UTF-8", "de_DE.UTF-8"],
#   }
#
# or:
#
#   glibc_locales = prev.glibc_locales & { all_locales = true }
#
# `all_locales` means every entry in glibc's installed SUPPORTED file,
# including legacy non-UTF-8 locales. When it is true, `locales` is ignored.
fun pkgs =>
  let glibc_locales_rootfs = {
    name = "glibc-locales-build-rootfs",
    tag = "RootfsClosure",
    config = {},
    inputs = {
      base = pkgs.base_filesystem,
      glibc = pkgs.glibc,
      bash = pkgs.bash,
      coreutils = pkgs.coreutils,
      sed = pkgs.sed,
      gawk = pkgs.gawk,
      grep = pkgs.grep,
      gzip = pkgs.gzip,
    },
  }
  in

  let glibc_locales = {
    locales
      | default
      = [
        "en_US.UTF-8",
        "ru_RU.UTF-8",
      ],
    all_locales | default = false,
    # This recipe consumes pkgs.glibc directly, so its cache key already binds
    # the archive to the exact libc/localedef build.
    name = "glibc-locales-2.42",
    tag = "SandboxInstall",
    config = {
      script_config = {},
      steps = [
        {
          name = "build_locale_archive",
          run_as = "root",
          cwd = "/",
          env = {
            ALL_LOCALES = if all_locales then "1" else "0",
            REQUESTED_LOCALES = std.string.join "\n" locales,
          },
          argv = [
            "/bin/bash",
            "-ec",
            m%"
              supported=/usr/share/i18n/SUPPORTED
              entries=/tmp/glibc-locales.entries
              archive=/usr/lib/locale/locale-archive
              manifest=/usr/share/bobr/glibc-locales/SUPPORTED

              if [ ! -r "$supported" ]; then
                echo "glibc locale list is missing: $supported" >&2
                exit 1
              fi

              # Extract the canonical localedef target/charmap pairs used by
              # glibc's own localedata/install-locales target.
              available_entries()
              {
                sed -n \
                  's/^[[:space:]]*\([^#[:space:]][^[:space:]]*\/[^[:space:]]*\)[[:space:]]*\\$/\1/p' \
                  "$supported"
              }

              if [ "$ALL_LOCALES" = 1 ]; then
                available_entries > "$entries"
              else
                : > "$entries"
                if [ -z "$REQUESTED_LOCALES" ]; then
                  echo "locales must not be empty when all_locales is false" >&2
                  exit 1
                fi

                while IFS= read -r requested; do
                  if [ -z "$requested" ]; then
                    echo "locale names must not be empty" >&2
                    exit 1
                  fi
                  case "$requested" in
                    *[!A-Za-z0-9_.@-]*)
                      echo "invalid locale name: $requested" >&2
                      exit 1
                      ;;
                  esac

                  entry="$(
                    available_entries \
                      | gawk -F/ -v requested="$requested" \
                          '$1 == requested { print; found++ }
                           END { if (found != 1) exit 1 }'
                  )" || {
                    echo "locale is not uniquely present in glibc SUPPORTED: $requested" >&2
                    exit 1
                  }

                  if grep -Fqx "$entry" "$entries"; then
                    echo "duplicate locale: $requested" >&2
                    exit 1
                  fi
                  printf '%s\n' "$entry" >> "$entries"
                done < <(printf '%s\n' "$REQUESTED_LOCALES")
              fi

              if [ ! -s "$entries" ]; then
                echo "glibc SUPPORTED produced an empty locale selection" >&2
                exit 1
              fi

              install -d /usr/lib/locale /usr/share/bobr/glibc-locales
              : > "$manifest"

              # This is the build-one-locale rule from glibc's localedata
              # Makefile, executed sequentially so a single archive is never
              # updated by concurrent localedef processes.
              while IFS= read -r locale; do
                charset="${locale##*/}"
                locale_name="${locale%%/*}"
                input="$(
                  printf '%s\n' "$locale_name" \
                    | sed 's/\([^.]*\)[^@]*\(.*\)/\1\2/'
                )"
                flags=()
                case "$charset" in
                  SHIFT_JIS|SHIFT_JISX0213)
                    flags+=(--no-warnings=ascii)
                    ;;
                esac

                echo "generating locale $locale_name ($charset)"
                I18NPATH=/usr/share/i18n \
                LOCALE_ARCHIVE="$archive" \
                LC_ALL=C \
                  /usr/bin/localedef \
                    "${flags[@]}" \
                    --alias-file=/usr/share/locale/locale.alias \
                    -i "$input" \
                    -f "$charset" \
                    "$locale_name"

                printf '%s\n' "$locale_name" >> "$manifest"
              done < "$entries"

              if [ ! -s "$archive" ]; then
                echo "localedef did not create $archive" >&2
                exit 1
              fi

              # Verify each selected locale through the same patched libc and
              # archive that HostBundle will use.
              while IFS= read -r locale; do
                charset="${locale##*/}"
                locale_name="${locale%%/*}"
                actual="$(
                  LOCALE_ARCHIVE="$archive" \
                  LC_ALL="$locale_name" \
                    /usr/bin/locale charmap
                )"
                if [ "$actual" != "$charset" ]; then
                  echo "locale $locale_name reports charmap '$actual', expected '$charset'" >&2
                  exit 1
                fi
              done < "$entries"

              # With LOCALE_ARCHIVE set, a missing archive must not silently
              # fall back to the FHS archive that was just created above.
              probe_locale="$(
                gawk -F/ '$1 !~ /^(C|POSIX)(\.|$)/ { print; exit }' "$entries"
              )"
              if [ -n "$probe_locale" ]; then
                probe_charset="${probe_locale##*/}"
                probe_name="${probe_locale%%/*}"
                missing_actual="$(
                  LOCALE_ARCHIVE=/usr/lib/locale/definitely-missing \
                  LC_ALL="$probe_name" \
                    /usr/bin/locale charmap 2>/dev/null || true
                )"
                if [ "$missing_actual" = "$probe_charset" ]; then
                  echo "LOCALE_ARCHIVE unexpectedly fell back to the FHS archive" >&2
                  exit 1
                fi
              fi

              chmod 0444 "$archive" "$manifest"
            "%,
          ],
        },
      ],
    },
    inputs = {
      _rootfs = glibc_locales_rootfs,
    },
  }
  in

  {
    include [
      glibc_locales,
    ],
  }
