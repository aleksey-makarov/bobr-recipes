
fun pkgs =>
  let mesa_src = fun version => fun hash => {
    name = "mesa-src-%{version}",
    tag = "Source",
    object_hash = hash,
    origin = {
      tag = "Http",
      url = "https://archive.mesa3d.org/mesa-%{version}.tar.xz",
    },
  }
  in

  # Graphics stack for a QEMU virtio-gpu guest. GL/GLES goes through the virgl
  # Gallium driver, whose scanout presents to the qemu window; the venus/blob
  # scanout does not display on the current qemu 10.1 / virglrenderer 1.2 (the
  # guest renders and issues set_scanout_blob + flush without error, but nothing
  # appears -- only classic transfer-based scanouts show). The venus Vulkan
  # driver (`virtio`) forwards Vulkan to the host for Vulkan apps; zink
  # (GL-on-Vulkan) is built too but is not the default for virtio-gpu. No LLVM,
  # The Wayland platform (-Dplatforms=wayland) makes Mesa's WSI advertise
  # VK_KHR_wayland_surface (venus) and provide the Wayland EGL platform, so
  # Wayland GL/Vulkan clients (incl. the GNOME session) can create surfaces.
  # Zink/venus need the Vulkan headers at build and the loader at runtime.
  let mesa_guest = {
    version | default = "26.1.4",
    source_object_hash | default = "072705caa9adf4740f1489194b13e278ad959166863b5271fe423a86353c9ab6",
    name = "mesa-guest-%{version}",
    tag = "Meson",
    deps = {
      build = [
        pkgs.libdrm,
        pkgs.zlib,
        pkgs.zstd,
        pkgs.expat,
        pkgs.bison,
        pkgs.flex,
        pkgs.vulkan_headers,
        pkgs.wayland,
        pkgs.wayland_protocols,
        # mesa's GL dispatch / format tables are generated by Python scripts that
        # use Mako and PyYAML (no longer bundled into the interpreter).
        pkgs.python_mako,
        pkgs.python_pyyaml,
      ],
      runtime = [
        pkgs.glibc_libs,
        pkgs.gcc_libs,
        pkgs.libdrm_libs,
        pkgs.zlib,
        pkgs.zstd,
        pkgs.expat,
        pkgs.vulkan_loader,
        pkgs.wayland,
      ],
    },
    config = {
      setup_args = [
        "--buildtype=release",
        "--libdir=/usr/lib",
        "-Dplatforms=wayland",
        "-Dgallium-drivers=virgl,zink",
        "-Dvulkan-drivers=virtio",
        "-Dllvm=disabled",
        "-Dgbm=enabled",
        "-Degl=enabled",
        "-Dgles2=enabled",
        "-Dopengl=true",
        "-Dglx=disabled",
        "-Dglvnd=disabled",
        "-Dshared-glapi=enabled",
        "-Dvideo-codecs=",
      ],
    },
    inputs = {
      source = mesa_src version source_object_hash,
    },
  }
  in

  # Mesa's Rust subprojects are declared as immutable Meson wraps. Network
  # access is unavailable in the build sandbox, so materialize every Rust wrap
  # source into one Bundle and seed Meson's packagecache before configure.
  let mesa_rust_crate_specs = [
    { name = "bitflags", version = "2.9.1", hash = "1b8e56985ec62d17e9c1001dc89c88ecd7dc08e47eba5ec7c29c7b5eeecde967" },
    { name = "cfg-if", version = "1.0.0", hash = "baf1de4339761588bc0619e3cbc0120ee582ebb74b53b4efbf79117bd2da40fd" },
    { name = "equivalent", version = "1.0.1", hash = "5443807d6dff69373d433ab9ef5378ad8df50ca6298caf15de6e52e24aaf54d5" },
    { name = "errno", version = "0.3.12", hash = "cea14ef9355e3beab063703aa9dab15afd25f0667c341310c1e5274bb1d0da18" },
    { name = "hashbrown", version = "0.14.1", hash = "7dfda62a12f55daeae5015f81b0baea145391cb4520f86c248fc615d72640d12" },
    { name = "indexmap", version = "2.2.6", hash = "168fb715dda47215e360912c096649d23d58bf392ac62f73919e831745e40f26" },
    { name = "libc", version = "0.2.171", hash = "c19937216e9d3aa9956d9bb8dfc0b0c8beb6058fc4f7a4dc4d850edf86a237d6" },
    { name = "log", version = "0.4.27", hash = "13dc2df351e3202783a1fe0d44375f7295ffb4049267b0f3018346dc122a1d94" },
    { name = "once_cell", version = "1.8.0", hash = "692fcb63b64b1758029e0a96ee63e049ce8c5948587f2f7208df04625e5f6b56" },
    { name = "paste", version = "1.0.14", hash = "de3145af08024dea9fa9914f381a17b8fc6034dfb00f3a84013f7ff43f29ed4c" },
    { name = "pest", version = "2.8.0", hash = "198db74531d58c70a361c42201efde7e2591e976d518caf7662a47dc5720e7b6" },
    { name = "pest_derive", version = "2.8.0", hash = "d725d9cfd79e87dccc9341a2ef39d1b6f6353d68c4b33c177febbe1a402c97c5" },
    { name = "pest_generator", version = "2.8.0", hash = "db7d01726be8ab66ab32f9df467ae8b1148906685bbe75c82d1e65d7f5b3f841" },
    { name = "pest_meta", version = "2.8.0", hash = "7f9f832470494906d1fca5329f8ab5791cc60beb230c74815dff541cbd2b5ca0" },
    { name = "proc-macro2", version = "1.0.86", hash = "5e719e8df665df0d1c8fbfd238015744736151d4445ec0836b8e628aae103b77" },
    { name = "quote", version = "1.0.35", hash = "291ec9ab5efd934aaf503a6466c5d5251535d108ee747472c3977cc5acc868ef" },
    { name = "remain", version = "0.2.12", hash = "1ad5e011230cad274d0532460c5ab69828ea47ae75681b42a841663efffaf794" },
    { name = "roxmltree", version = "0.20.0", hash = "6c20b6793b5c2fa6553b250154b78d6d0db37e72700ae35fad9387a46f487c97" },
    { name = "rustc-hash", version = "2.1.1", hash = "357703d41365b4b27c590e3ed91eabb1b663f07c4c084095e60cbed4362dff0d" },
    { name = "rustix", version = "1.1.2", hash = "cd15f8a2c5551a84d56efdc1cd049089e409ac19a3072d5037a17fd70719ff3e" },
    { name = "syn", version = "2.0.87", hash = "25aa4ce346d03a6dcd68dd8b4010bcb74e54e62c90c573f394c46eae99aba32d" },
    { name = "thiserror", version = "2.0.11", hash = "d452f284b73e6d76dd36758a0c8684b1d5be31f92b89d07fd5822175732206fc" },
    { name = "thiserror-impl", version = "2.0.11", hash = "26afc1baea8a989337eeb52b6e72a039780ce45c3edfcc9c5b9d112feeb173c2" },
    { name = "ucd-trie", version = "0.1.6", hash = "ed646292ffc8188ef8ea4d1e0e0150fb15a5c2e12ad9b8fc191ae7a8a7f3c4b9" },
    { name = "unicode-ident", version = "1.0.12", hash = "3354b9ac3fae1ff6755cb6db53683adb661634f67557942dea4facebec0fee4b" },
    { name = "windows-link", version = "0.2.0", hash = "45e46c0661abb7180e7b9c281db115305d49ca1709ab8242adf09666d2173c65" },
    { name = "windows-sys", version = "0.61.1", hash = "6f109e41dd4a3c848907eb83d5a42ea98b3769495597450cf6d153507b166f0f" },
    { name = "zerocopy", version = "0.8.13", hash = "67914ab451f3bfd2e69e5e9d2ef3858484e7074d63f204fd166ec391b54de21d" },
    { name = "zerocopy-derive", version = "0.8.13", hash = "7988d73a4303ca289df03316bc490e934accf371af6bc745393cf3c2c5c4f25d" },
  ]
  in
  let mesa_rust_crate_source = fun spec => {
    name =
      "mesa_crate_"
      ++ (spec.name |> std.string.replace "-" "_")
      ++ "_"
      ++ (spec.version |> std.string.replace "." "_"),
    tag = "Source",
    object_hash = spec.hash,
    origin = {
      tag = "Http",
      url =
        "https://static.crates.io/crates/%{spec.name}/%{spec.name}-%{spec.version}.crate",
    },
  }
  in
  let mesa_rust_crates = fun version =>
    {
      name = "mesa-rust-crates-%{version}",
      tag = "Bundle",
      config = {},
      inputs =
        std.array.fold_left
          (fun acc =>
            fun spec =>
              let src = mesa_rust_crate_source spec in
              std.record.insert src.name src acc
          )
          {}
          mesa_rust_crate_specs,
    }
  in

  # Full host graphics stack: Wayland-only OpenGL/EGL/GLES plus open Gallium
  # and Vulkan drivers for software, Intel, AMD, and NVIDIA hardware.
  let mesa = {
    version | default = "26.1.4",
    source_object_hash | default = "072705caa9adf4740f1489194b13e278ad959166863b5271fe423a86353c9ab6",
    name = "mesa-%{version}",
    tag = "Meson",
    deps = {
      build = [
        pkgs.libdrm,
        pkgs.elfutils,
        pkgs.zlib,
        pkgs.zstd,
        pkgs.expat,
        pkgs.bison,
        pkgs.flex,
        pkgs.pkgconf,
        pkgs.vulkan_headers,
        pkgs.wayland,
        pkgs.wayland_protocols,
        pkgs.python_mako,
        pkgs.python_pyyaml,
        pkgs.llvm_bin,
        pkgs.libclc,
        pkgs.spirv_headers,
        pkgs.spirv_tools,
        pkgs.spirv_llvm_translator,
        pkgs.glslang,
        pkgs.rust_bin,
        pkgs.bindgen,
        pkgs.cbindgen,
        pkgs.libglvnd,
      ],
      runtime = [
        pkgs.glibc_libs,
        pkgs.gcc_libs,
        pkgs.libdrm_libs,
        pkgs.elfutils,
        pkgs.zlib,
        pkgs.zstd,
        pkgs.expat,
        pkgs.wayland,
        pkgs.libglvnd,
      ],
    },
    config = {
      env = {
        LIBCLANG_PATH = "/usr/lib",
      },
      pre_configure = {
        name = "seed_rust_subprojects",
        run_as = "build-user",
        argv = [
          "/bin/sh",
          "-ec",
          m%"
            packagecache="@{build}/source/subprojects/packagecache"
            mkdir -p "${packagecache}"
            for crate in "@{rust_crates}"/*
            do
              top=$(tar -tf "${crate}" | sed -n '1{s,/.*,,;p;q;}')
              test -n "${top}"
              cp "${crate}" "${packagecache}/${top}.tar.gz"
            done
          "%,
        ],
      },
      post_install = {
        name = "relocate_vulkan_manifests",
        run_as = "root",
        argv = [
          "/bin/sh",
          "-ec",
          m%"
            for manifest in /usr/share/vulkan/icd.d/*.json
            do
              sed -i 's#"library_path": "/usr/lib/#"library_path": "#' \
                "${manifest}"
              if grep -q '"library_path": "/' "${manifest}"; then
                echo "absolute Vulkan ICD library_path in ${manifest}" >&2
                exit 1
              fi
            done
          "%,
        ],
      },
      setup_args = [
        "--buildtype=release",
        "--libdir=/usr/lib",
        "-Dcpp_rtti=false",
        "-Db_lto=false",
        "-Dplatforms=wayland",
        "-Degl-native-platform=wayland",
        "-Dgallium-drivers=llvmpipe,softpipe,iris,crocus,radeonsi,nouveau,zink",
        "-Dvulkan-drivers=swrast,intel,intel_hasvk,amd,nouveau",
        "-Dllvm=enabled",
        "-Dshared-llvm=disabled",
        "-Dstatic-libclc=spirv64",
        "-Dmesa-clc=enabled",
        "-Dinstall-mesa-clc=false",
        "-Dprecomp-compiler=enabled",
        "-Dinstall-precomp-compiler=false",
        "-Dspirv-tools=enabled",
        "-Dgbm=enabled",
        "-Degl=enabled",
        "-Dgles1=disabled",
        "-Dgles2=enabled",
        "-Dopengl=true",
        "-Dglx=disabled",
        "-Dglvnd=enabled",
        "-Dxlib-lease=disabled",
        "-Dgallium-va=disabled",
        "-Dgallium-rusticl=false",
        "-Dvideo-codecs=",
        "-Dvulkan-layers=",
        "-Dtools=",
        "-Dbuild-tests=false",
        "-Dbuild-radv-tests=false",
        "-Dbuild-aco-tests=false",
        "-Dvalgrind=disabled",
        "-Dlibunwind=disabled",
        "-Dlmsensors=disabled",
        "-Dmicrosoft-clc=disabled",
        "-Dallow-fallback-for=",
        "-Dxmlconfig=enabled",
        "-Dshader-cache=enabled",
      ],
    },
    inputs = {
      source = mesa_src version source_object_hash,
      rust_crates = mesa_rust_crates version,
    },
  }
  in

  {
    include [
      mesa_guest,
      mesa,
    ],
  }
